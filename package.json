{
  "name": "resilient-privacy-site",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "check:copy": "! grep -rnE '\\[(placeholder|proposed name)' app components | grep -vE ':[0-9]+:[[:space:]]*(//|/\\*|\\{/\\*|\\*)' | grep -v 'data-gap'",
    "prebuild": "npm run -s check:copy",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "geist": "^1.9.2",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
