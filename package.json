{
  "name": "resilient-privacy-site",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "check:copy": "! grep -rnE '\\[(placeholder|proposed name)' app components | grep -vE ':[0-9]+:[[:space:]]*(//|/\\*|\\{/\\*|\\*)' | grep -v 'data-gap'",
    "prebuild": "npm run -s check:copy",
    "build": "node scripts/csp-build.mjs",
    "start": "next start",
    "check:forms": "node --no-warnings components/company/inquiry.check.mjs"
  },
  "dependencies": {
    "geist": "^1.9.2",
    "next": "^16.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "sharp@0.35.5": true
  }
}
