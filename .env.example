# Contact/demo form email via Resend (https://resend.com). Copy to .env.local, or set in Vercel > Project > Settings > Environment Variables.
# Leave RESEND_API_KEY empty and the forms fall back to opening the visitor's email app (mailto).
RESEND_API_KEY=
# Sender; the domain must be verified in Resend.
INQUIRY_FROM="Website <no-reply@resilientprivacy.com>"
# Inbox that receives submissions.
INQUIRY_TO=vishva@resilientprivacy.com
